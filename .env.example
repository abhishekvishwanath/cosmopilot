# CosmoPilot — Environment Variables
#
# Copy this file to .env (and .env.local for apps/web where Next.js expects it)
# and fill in real values. Never commit .env or any file containing real secrets.
#
# Each variable is tagged with the phase it's actually needed in (see CLAUDE.md §32).
# The app runs in full mock/demo mode with NONE of the provider keys set — only
# APP / DATABASE variables are required to get past Phase 1.

# ── App (Phase 1) ────────────────────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_URL=http://localhost:3000      # public URL of apps/web
API_URL=http://localhost:8000      # public URL of apps/api
LOG_LEVEL=info
MOCK_MODE=true                     # when true, every provider factory returns its Mock* implementation

# ── Supabase / Database (Phase 1) ────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, apps/api — never exposed to apps/web
DATABASE_URL=                       # Postgres connection string used by FastAPI/migrations

# ── Auth (Phase 1) ────────────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=

# ── AI Knowledge Base + Concierge (Phase 5-6) ─────────────────────────────────
# Project decision: free/local models for the prototype (no API key needed),
# paid providers deferred to production. Both default to the real local
# implementation already — only set these to override.
EMBEDDING_PROVIDER=fastembed        # fastembed (BAAI/bge-small-en-v1.5, local, free) | mock
LLM_PROVIDER=ollama                 # ollama (local, free — `ollama serve` must be running) | mock
OLLAMA_URL=http://localhost:11434
# qwen2.5:7b, not llama3 — llama3 (Meta's 3.0 release) doesn't support tool
# calling in Ollama at all, which the AI Concierge (Phase 6) needs. Any
# locally-pulled tool-calling-capable Ollama model works: `ollama pull <model>`.
OLLAMA_MODEL=qwen2.5:7b

# When moving to a paid provider (production): add ANTHROPIC_API_KEY /
# OPENAI_API_KEY and a real embeddings/LLM provider implementation — the
# EmbeddingProvider/LLMProvider abstractions (apps/api/app/providers/) mean
# this is a config change, not a rewrite.

# ── Voice / Vapi (Phase 10) ───────────────────────────────────────────────────
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# ── WhatsApp / Meta Cloud API (Phase 9) ───────────────────────────────────────
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=                    # used to verify webhook signatures

# ── Email / Resend (Phase 4+) ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# ── Payments / Stripe (only if payment functionality is required) ────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── n8n (Phase 8) ──────────────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=                # n8n instance URL that apps/api triggers workflows on
N8N_WEBHOOK_SHARED_SECRET=           # shared secret checked on inbound n8n → apps/api calls

# ── Analytics (Phase 11, optional) ────────────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=
