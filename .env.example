# CosmoPilot — Environment Variables
#
# Copy this file to .env (and .env.local for apps/web where Next.js expects it)
# and fill in real values. Never commit .env or any file containing real secrets.
#
# Each variable is tagged with the phase it's actually needed in (see CLAUDE.md §32).
# The app runs in full mock/demo mode with NONE of the provider keys set — only
# APP / DATABASE variables are required to get past Phase 1.

# ── App (Phase 1) ────────────────────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_URL=http://localhost:3000      # public URL of apps/web
API_URL=http://localhost:8000      # public URL of apps/api
LOG_LEVEL=info
MOCK_MODE=true                     # when true, every provider factory returns its Mock* implementation

# ── Supabase / Database (Phase 1) ────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, apps/api — never exposed to apps/web
DATABASE_URL=                       # Postgres connection string used by FastAPI/migrations

# ── Auth (Phase 1) ────────────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=

# ── AI Knowledge Base + Concierge (Phase 5-7) ─────────────────────────────────
# Embeddings stay free/local (fastembed, no API key). The answer-generation
# LLM moved from local Ollama to Groq's hosted API on 2026-09-06 — live
# testing showed the local qwen2.5:7b model hallucinating and unreliably
# issuing tool calls in multi-turn conversations. Get a free key at
# https://console.groq.com/keys.
EMBEDDING_PROVIDER=fastembed        # fastembed (BAAI/bge-small-en-v1.5, local, free) | mock
LLM_PROVIDER=groq                   # groq (hosted, needs GROQ_API_KEY) | ollama (local, free) | mock
GROQ_API_KEY=
# openai/gpt-oss-120b — Groq's largest open-weight (Apache-2.0), tool-calling
# -capable model. See `curl https://api.groq.com/openai/v1/models` (with your
# key) for the current catalog if this ever needs revisiting.
GROQ_MODEL=openai/gpt-oss-120b

# Ollama — kept as an alternative free/local option (no API key), no longer
# the default. `ollama serve` must be running locally to use it.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# When moving to a different paid provider (e.g. Anthropic/OpenAI directly)
# for production: the EmbeddingProvider/LLMProvider abstractions
# (apps/api/app/providers/) mean this is a config change, not a rewrite.

# ── Voice / Vapi (Phase 10) ───────────────────────────────────────────────────
# Vapi is call transport only — the model/tools/prompt it runs are
# provisioned by apps/api/scripts/create_vapi_assistant.py from the same
# sources the text Concierge uses. See that script's docstring for usage.
VOICE_PROVIDER=mock                 # mock (default) | vapi (needs the four values below)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=                  # printed by create_vapi_assistant.py on first run
VAPI_PHONE_NUMBER_ID=               # from Vapi dashboard -> Phone Numbers
VAPI_WEBHOOK_SECRET=                # generate one (e.g. `openssl rand -base64 32`); checked
                                     # on inbound Vapi -> apps/api calls via x-vapi-secret

# ── WhatsApp / Meta Cloud API (Phase 9) ───────────────────────────────────────
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=                    # used to verify webhook signatures

# ── Email / Resend (Phase 4+) ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# ── Payments / Stripe (only if payment functionality is required) ────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── n8n (Phase 8) ──────────────────────────────────────────────────────────────
# See workflows/n8n/README.md for the four workflow JSON files, the n8n
# Variables they need, and import instructions.
N8N_WEBHOOK_BASE_URL=                # n8n instance URL — FastAPI posts to {this}/webhook/{event}
N8N_WEBHOOK_SHARED_SECRET=           # checked on inbound n8n → apps/api calls via X-Webhook-Secret;
                                      # must match the COSMOPILOT_WEBHOOK_SECRET n8n Variable

# ── Analytics (Phase 11, optional) ────────────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=
