# apps/api — copy to .env and fill in real values.
# .env is gitignored; never commit real secrets.

APP_ENV=development
LOG_LEVEL=info
MOCK_MODE=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Supabase (Phase 1) — see ../../README.md for the "get these from scratch" guide.
