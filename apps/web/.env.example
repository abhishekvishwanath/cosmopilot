# apps/web — copy to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.
#
# Only NEXT_PUBLIC_* variables are available in the browser — see
# ../../docs/ARCHITECTURE.md and Next.js's environment-variables guide.

# FastAPI backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (Phase 1) — see ../../README.md for the "get these from scratch" guide.
# Anon key only; the service role key belongs in apps/api, never here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
